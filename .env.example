# Contoh file .env - Copy ke .env dan isi dengan nilai sebenarnya

# Konfigurasi Aplikasi
APP_NAME="Sistem E-commerce"
APP_VERSION="1.0.0"
DEBUG=True

# Database (ubah sesuai kebutuhan)
DB_HOST=localhost
DB_NAME=ecommerce_db
DB_USER=your_username
DB_PASSWORD=your_password

# API Keys (dapatkan dari penyedia layanan)
API_KEY=your_api_key_here

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password